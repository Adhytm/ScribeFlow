    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.25.12",
    "@rollup/rollup-win32-x64-msvc": "^4.63.5"
  }
